# Telegram API credentials from https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash
BOT_TOKEN=your_new_bot_token

# One target or multiple authorized targets, comma-separated
# These must be channels you own or where you have permission to post.
TARGET_CHANNEL=@your_own_channel
# TARGET_CHANNELS=@channel_one,@channel_two

# Optional caption rewrite; keep the key private and never commit .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AUTO_HASHTAGS=#Movie #MyanmarSubtitle

SESSION_NAME=auto_post_bot_session
DATA_FILE=bot_data.json
